<div id="cv-toast-host" style="position:fixed; top:78px; right:16px; z-index:3000; pointer-events:none;"></div>

<c:set var="_gMsg" value="${empty msg ? param.msg : msg}" />
<c:set var="_gType" value="${empty type ? (empty param.type ? 'info' : param.type) : type}" />
<c:if test="${empty _gMsg}">
  <c:set var="_gMsg" value="${empty error ? param.error : error}" />
  <c:if test="${not empty _gMsg}">
    <c:set var="_gType" value="error" />
  </c:if>
</c:if>
<c:if test="${empty _gMsg}">
  <c:set var="_gMsg" value="${empty success ? param.success : success}" />
  <c:if test="${not empty _gMsg}">
    <c:set var="_gType" value="success" />
  </c:if>
</c:if>
<div id="cv-fallback-toast" data-type="${_gType}" style="display:none;"><c:out value="${_gMsg}" /></div>

<style>
.cv-toast {
  min-width: 270px;
  max-width: 420px;
  border: 1px solid #d5dde8;
  border-radius: 12px;
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
  padding: 12px 14px;
  font-weight: 600;
  font-size: 13px;
  margin-bottom: 10px;
  opacity: 0;
  transform: translateY(-8px);
  transition: all .22s ease;
  pointer-events: auto;
  background: #ffffff;
  color: #1f2937;
}
.cv-toast.show { opacity: 1; transform: translateY(0); }
.cv-toast.success { border-left: 4px solid #0f766e; }
.cv-toast.error { border-left: 4px solid #dc2626; }
.cv-toast.info { border-left: 4px solid #2563eb; }
</style>

<script>
(function () {
  function showToast(message, type) {
    var host = document.getElementById('cv-toast-host');
    if (!host || !message) return;

    var t = document.createElement('div');
    t.className = 'cv-toast ' + (type || 'info');
    t.textContent = message;
    host.appendChild(t);

    requestAnimationFrame(function () { t.classList.add('show'); });
    setTimeout(function () {
      t.classList.remove('show');
      setTimeout(function () {
        if (t.parentNode) t.parentNode.removeChild(t);
      }, 220);
    }, 5000);
  }

  document.addEventListener('DOMContentLoaded', function () {
    var d = document.getElementById('toast-data');
    if (!d || !d.textContent || !d.textContent.trim()) {
      d = document.getElementById('cv-fallback-toast');
    }
    if (d && d.textContent && d.textContent.trim()) {
      showToast(d.textContent.trim(), d.getAttribute('data-type') || 'info');
    }
  });

  window.showToast = showToast;
})();
</script>
